Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Frame Rate: 20
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 40
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Show Names: true
    Marker Scale: 0.5
  - Class: rviz_default_plugins/Image
    Name: Colour
    Enabled: true
    Topic:
      Value: /camera/color/image_raw
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/Image
    Name: Depth
    Enabled: true
    Topic:
      Value: /camera/depth/image_raw
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/PointCloud2
    Name: Depth cloud
    Enabled: true
    Size (m): 0.02
    Style: Points
    Topic:
      Value: /camera/depth/points
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/Odometry
    Name: Ground truth
    Enabled: true
    Keep: 200
    Topic:
      Value: /ground_truth/odom
      Reliability Policy: Best Effort
    Shape:
      Shaft Length: 0.3
      Head Length: 0.1
  - Class: rviz_default_plugins/MarkerArray
    Name: Targets
    Enabled: true
    Topic:
      Value: /oak/detection_markers
      Depth: 10
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Namespaces: {}
  - Class: rviz_default_plugins/LaserScan
    Name: Obstacle scan
    Enabled: true
    Topic:
      Value: /scan
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
    Size (m): 0.05
    Style: Spheres
    Color: 255; 40; 40
    Color Transformer: FlatColor
    Decay Time: 0
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: -12
        Y: 0
        Z: 1
      Pitch: 0.4
      Yaw: 0.0
