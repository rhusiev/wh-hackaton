<?xml version="1.0"?>
<!--
  Y3 tricopter, ~3.0 kg AUW, 0.27 m arms, 10" tri-blade props.
  Rotor aerodynamics are tuned so that one rotor makes 31.4 N at 1000 rad/s
  and draws ~840 W of shaft power there; see docs/NOTES.md for the derivation.
-->
<sdf version="1.9">
  <model name="tricopter">

    <link name="base_link">
      <inertial>
        <mass>2.58</mass>
        <inertia>
          <ixx>0.0125</ixx><iyy>0.0146</iyy><izz>0.0209</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <geometry><box><size>0.24 0.12 0.09</size></box></geometry>
      </collision>
      <collision name="skid_left_collision">
        <pose>0 0.09 -0.14 0 0 0</pose>
        <geometry><box><size>0.22 0.02 0.02</size></box></geometry>
      </collision>
      <collision name="skid_right_collision">
        <pose>0 -0.09 -0.14 0 0 0</pose>
        <geometry><box><size>0.22 0.02 0.02</size></box></geometry>
      </collision>

      <visual name="body_visual">
        <geometry><box><size>0.24 0.12 0.09</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.12 1</ambient>
          <diffuse>0.15 0.15 0.18 1</diffuse>
        </material>
      </visual>
      <visual name="arm_front_right">
        <pose>0.0675 -0.11691 0 0 1.5708 -1.0472</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.27</length></cylinder></geometry>
        <material><diffuse>0.8 0.2 0.1 1</diffuse></material>
      </visual>
      <visual name="arm_front_left">
        <pose>0.0675 0.11691 0 0 1.5708 1.0472</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.27</length></cylinder></geometry>
        <material><diffuse>0.8 0.2 0.1 1</diffuse></material>
      </visual>
      <visual name="arm_rear">
        <pose>-0.135 0 0 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.27</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
      <visual name="pod_front_right">
        <pose>0.135 -0.23383 0.022 0 0 0</pose>
        <geometry><cylinder><radius>0.0165</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>0.3 0.3 0.33 1</diffuse></material>
      </visual>
      <visual name="pod_front_left">
        <pose>0.135 0.23383 0.022 0 0 0</pose>
        <geometry><cylinder><radius>0.0165</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>0.3 0.3 0.33 1</diffuse></material>
      </visual>
      <visual name="skid_left_visual">
        <pose>0 0.09 -0.14 0 0 0</pose>
        <geometry><box><size>0.22 0.02 0.02</size></box></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
      <visual name="skid_right_visual">
        <pose>0 -0.09 -0.14 0 0 0</pose>
        <geometry><box><size>0.22 0.02 0.02</size></box></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
      <visual name="strut_left">
        <pose>0 0.09 -0.095 0 0 0</pose>
        <geometry><cylinder><radius>0.006</radius><length>0.1</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
      <visual name="strut_right">
        <pose>0 -0.09 -0.095 0 0 0</pose>
        <geometry><cylinder><radius>0.006</radius><length>0.1</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <link name="imu_link">
      <pose>0 0 0.02 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0003394</stddev>
              <bias_mean>0.0000075</bias_mean><bias_stddev>0.0000008</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0003394</stddev>
              <bias_mean>0.0000075</bias_mean><bias_stddev>0.0000008</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0003394</stddev>
              <bias_mean>0.0000075</bias_mean><bias_stddev>0.0000008</bias_stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.004</stddev>
              <bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.004</stddev>
              <bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.004</stddev>
              <bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- Rigid nose mount, pitched 15 deg down. -->
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <link name="camera_link">
      <pose>0.135 0 -0.01 0 0.2618 0</pose>
      <inertial>
        <mass>0.091</mass>
        <inertia>
          <ixx>2e-5</ixx><iyy>2e-5</iyy><izz>2e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="camera_visual">
        <geometry><box><size>0.029 0.091 0.028</size></box></geometry>
        <material><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <!-- Luxonis OAK-D. One gz sensor cannot have separate colour and stereo
           optics, so it carries the colour FOV (68.8 deg): depthai aligns depth
           into the colour frame, and that aligned pair is what the Pi 5 gets. -->
      <sensor name="rgbd" type="rgbd_camera">
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <topic>rgbd</topic>
        <camera>
          <horizontal_fov>1.2008</horizontal_fov>
          <image>
            <width>640</width>
            <height>400</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>20.0</far></clip>
          <!-- 0.7 m is the OAK-D stereo minimum at 800p: closer than that it
               returns nothing, so the drone is blind inside its own braking
               distance. Do not lower it to make obstacle avoidance easier. -->
          <depth_camera><clip><near>0.7</near><far>12.0</far></clip></depth_camera>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.02</stddev></noise>
          <distortion>
            <k1>0</k1><k2>0</k2><k3>0</k3><p1>0</p1><p2>0</p2>
            <center>0.5 0.5</center>
          </distortion>
          <optical_frame_id>camera_optical_frame</optical_frame_id>
        </camera>
      </sensor>
    </link>

    <joint name="rotor_fr_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_fr</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.0001</damping></dynamics>
      </axis>
    </joint>

    <link name="rotor_fr">
      <pose>0.135 -0.23383 0.045 0 0 0</pose>
      <inertial>
        <mass>0.13</mass>
        <inertia>
          <ixx>8e-5</ixx><iyy>8e-5</iyy><izz>1.3e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="disc_collision">
        <geometry><cylinder><radius>0.127</radius><length>0.008</length></cylinder></geometry>
      </collision>
      <visual name="hub"><geometry><cylinder><radius>0.014</radius><length>0.012</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="blade_a"><pose>0.0635 0 0 0 0 0</pose>
        <geometry><box><size>0.127 0.026 0.003</size></box></geometry>
        <material><diffuse>0.85 0.85 0.85 0.9</diffuse></material></visual>
      <visual name="blade_b"><pose>-0.03175 0.055 0 0 0 2.0944</pose>
        <geometry><box><size>0.127 0.026 0.003</size></box></geometry>
        <material><diffuse>0.85 0.85 0.85 0.9</diffuse></material></visual>
      <visual name="blade_c"><pose>-0.03175 -0.055 0 0 0 -2.0944</pose>
        <geometry><box><size>0.127 0.026 0.003</size></box></geometry>
        <material><diffuse>0.85 0.85 0.85 0.9</diffuse></material></visual>
    </link>

    <joint name="rotor_fl_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_fl</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.0001</damping></dynamics>
      </axis>
    </joint>

    <link name="rotor_fl">
      <pose>0.135 0.23383 0.045 0 0 0</pose>
      <inertial>
        <mass>0.13</mass>
        <inertia>
          <ixx>8e-5</ixx><iyy>8e-5</iyy><izz>1.3e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="disc_collision">
        <geometry><cylinder><radius>0.127</radius><length>0.008</length></cylinder></geometry>
      </collision>
      <visual name="hub"><geometry><cylinder><radius>0.014</radius><length>0.012</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="blade_a"><pose>0.0635 0 0 0 0 0</pose>
        <geometry><box><size>0.127 0.026 0.003</size></box></geometry>
        <material><diffuse>0.85 0.85 0.85 0.9</diffuse></material></visual>
      <visual name="blade_b"><pose>-0.03175 0.055 0 0 0 2.0944</pose>
        <geometry><box><size>0.127 0.026 0.003</size></box></geometry>
        <material><diffuse>0.85 0.85 0.85 0.9</diffuse></material></visual>
      <visual name="blade_c"><pose>-0.03175 -0.055 0 0 0 -2.0944</pose>
        <geometry><box><size>0.127 0.026 0.003</size></box></geometry>
        <material><diffuse>0.85 0.85 0.85 0.9</diffuse></material></visual>
    </link>

    <!-- Tail tilt: axis is body X, so tilting vectors the rear thrust into +/-Y
         and that is the only source of yaw authority on a tricopter. -->
    <joint name="tail_tilt_joint" type="revolute">
      <parent>base_link</parent>
      <child>tail_tilt_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-0.7854</lower><upper>0.7854</upper><effort>8</effort><velocity>12</velocity></limit>
        <dynamics><damping>0.02</damping></dynamics>
      </axis>
    </joint>

    <link name="tail_tilt_link">
      <pose>-0.27 0 0 0 0 0</pose>
      <inertial>
        <mass>0.06</mass>
        <inertia>
          <ixx>3e-5</ixx><iyy>5e-5</iyy><izz>5e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="pod"><pose>0 0 0.022 0 0 0</pose>
        <geometry><cylinder><radius>0.0165</radius><length>0.03</length></cylinder></geometry>
        <material><diffuse>0.3 0.3 0.33 1</diffuse></material></visual>
      <visual name="yoke"><pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.03 0.05 0.012</size></box></geometry>
        <material><diffuse>0.9 0.6 0.1 1</diffuse></material></visual>
    </link>

    <joint name="rotor_rear_joint" type="revolute">
      <parent>tail_tilt_link</parent>
      <child>rotor_rear</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.0001</damping></dynamics>
      </axis>
    </joint>

    <link name="rotor_rear">
      <pose>-0.27 0 0.045 0 0 0</pose>
      <inertial>
        <mass>0.13</mass>
        <inertia>
          <ixx>8e-5</ixx><iyy>8e-5</iyy><izz>1.3e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="disc_collision">
        <geometry><cylinder><radius>0.127</radius><length>0.008</length></cylinder></geometry>
      </collision>
      <visual name="hub"><geometry><cylinder><radius>0.014</radius><length>0.012</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="blade_a"><pose>0.0635 0 0 0 0 0</pose>
        <geometry><box><size>0.127 0.026 0.003</size></box></geometry>
        <material><diffuse>0.85 0.85 0.85 0.9</diffuse></material></visual>
      <visual name="blade_b"><pose>-0.03175 0.055 0 0 0 2.0944</pose>
        <geometry><box><size>0.127 0.026 0.003</size></box></geometry>
        <material><diffuse>0.85 0.85 0.85 0.9</diffuse></material></visual>
      <visual name="blade_c"><pose>-0.03175 -0.055 0 0 0 -2.0944</pose>
        <geometry><box><size>0.127 0.026 0.003</size></box></geometry>
        <material><diffuse>0.85 0.85 0.85 0.9</diffuse></material></visual>
    </link>

    <!-- Two opposite blades per rotor. A single off-axis blade puts a 0.9 N m moment
         on the hub that the physics step samples into a steady torque. -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.15</a0><cla>5.0</cla><cda>1.37</cda>
      <alpha_stall>0.35</alpha_stall><cla_stall>-2.0</cla_stall><cda_stall>0.0</cda_stall>
      <cp>0.089 0 0</cp>
      <area>0.00439</area>
      <air_density>1.2041</air_density>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_fr</link_name>
    </plugin>

    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.15</a0><cla>5.0</cla><cda>1.37</cda>
      <alpha_stall>0.35</alpha_stall><cla_stall>-2.0</cla_stall><cda_stall>0.0</cda_stall>
      <cp>-0.089 0 0</cp>
      <area>0.00439</area>
      <air_density>1.2041</air_density>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_fr</link_name>
    </plugin>

    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.15</a0><cla>5.0</cla><cda>1.37</cda>
      <alpha_stall>0.35</alpha_stall><cla_stall>-2.0</cla_stall><cda_stall>0.0</cda_stall>
      <cp>0.089 0 0</cp>
      <area>0.00439</area>
      <air_density>1.2041</air_density>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_fl</link_name>
    </plugin>

    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.15</a0><cla>5.0</cla><cda>1.37</cda>
      <alpha_stall>0.35</alpha_stall><cla_stall>-2.0</cla_stall><cda_stall>0.0</cda_stall>
      <cp>-0.089 0 0</cp>
      <area>0.00439</area>
      <air_density>1.2041</air_density>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_fl</link_name>
    </plugin>

    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.15</a0><cla>5.0</cla><cda>1.37</cda>
      <alpha_stall>0.35</alpha_stall><cla_stall>-2.0</cla_stall><cda_stall>0.0</cda_stall>
      <cp>0.089 0 0</cp>
      <area>0.00439</area>
      <air_density>1.2041</air_density>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_rear</link_name>
    </plugin>

    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.15</a0><cla>5.0</cla><cda>1.37</cda>
      <alpha_stall>0.35</alpha_stall><cla_stall>-2.0</cla_stall><cda_stall>0.0</cda_stall>
      <cp>-0.089 0 0</cp>
      <area>0.00439</area>
      <air_density>1.2041</air_density>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_rear</link_name>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/model/tricopter/odometry_truth</odom_topic>
      <tf_topic>/model/tricopter/pose</tf_topic>
    </plugin>

    <!-- ArduPilot servo channels: tricopter mixing uses outputs 1, 2 and 4 for the
         motors and output 7 for the tail servo, so channels 2, 4 and 5 are unused. -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <have_32_channels>0</have_32_channels>
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <imuName>imu_sensor</imuName>

      <control channel="0">
        <jointName>rotor_fr_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-1000</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.05</p_gain><i_gain>0.05</i_gain><d_gain>0</d_gain>
        <i_max>2.0</i_max><i_min>-2.0</i_min>
        <cmd_max>2.0</cmd_max><cmd_min>-2.0</cmd_min>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
      </control>

      <control channel="1">
        <jointName>rotor_fl_joint</jointName>
        <useForce>1</useForce>
        <multiplier>1000</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.05</p_gain><i_gain>0.05</i_gain><d_gain>0</d_gain>
        <i_max>2.0</i_max><i_min>-2.0</i_min>
        <cmd_max>2.0</cmd_max><cmd_min>-2.0</cmd_min>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
      </control>

      <control channel="3">
        <jointName>rotor_rear_joint</jointName>
        <useForce>1</useForce>
        <multiplier>1000</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.05</p_gain><i_gain>0.05</i_gain><d_gain>0</d_gain>
        <i_max>2.0</i_max><i_min>-2.0</i_min>
        <cmd_max>2.0</cmd_max><cmd_min>-2.0</cmd_min>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
      </control>

      <!-- ArduPilot sets the output-7 angular full scale to MOT_YAW_SV_ANGLE
           itself, so the whole 1000-2000 us span maps to +/-30 deg of tilt:
           multiplier = -2 * radians(30). Change it if you change that param.
           The sign is negative so that positive yaw demand yaws nose right. -->
      <control channel="6">
        <jointName>tail_tilt_joint</jointName>
        <multiplier>-1.0472</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/tricopter/tail_tilt/cmd</cmd_topic>
      </control>
    </plugin>

    <!-- The plugin's POSITION mode cannot hold this light joint, see docs/NOTES.md. -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>tail_tilt_joint</joint_name>
      <topic>/model/tricopter/tail_tilt/cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>30</p_gain>
      <cmd_max>10</cmd_max>
      <cmd_min>-10</cmd_min>
    </plugin>

  </model>
</sdf>
